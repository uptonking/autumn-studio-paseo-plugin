{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "paths": {
      "react-dom": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "react-dom/client": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "@base-ui/react/*": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "class-variance-authority": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "clsx": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "cmdk": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "tailwind-merge": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "lucide-react": ["./node_modules/.paseo-vendor/ui-vendor.js"],
      "@embedpdf/*": ["./node_modules/.paseo-vendor/pdf-vendor.js"],
      "pdf-lib": ["./node_modules/.paseo-vendor/pdf-lib-vendor.js"],
      "@extend-ai/react-xlsx": ["./node_modules/.paseo-vendor/xlsx-vendor.js"],
      "@datalking/begonia-react": ["./node_modules/.paseo-vendor/docx-vendor.js"],
      "@datalking/begonia-react/*": ["./node_modules/.paseo-vendor/docx-vendor.js"],
      "@datalking/begonia-browser": ["./node_modules/.paseo-vendor/docx-vendor.js"],
      "@datalking/begonia-browser/*": ["./node_modules/.paseo-vendor/docx-vendor.js"],
      "@datalking/begonia-docx-bridge": ["./node_modules/.paseo-vendor/docx-vendor.js"],
      "@datalking/begonia-docx-bridge/*": ["./node_modules/.paseo-vendor/docx-vendor.js"],
      "@pierre/trees": ["./node_modules/.paseo-vendor/trees-vendor.js"],
      "@pierre/trees/*": ["./node_modules/.paseo-vendor/trees-vendor.js"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "client/**/*",
    "server/**/*",
    "shared/**/*",
    "test/**/*",
    "index.client.tsx",
    "index.server.ts",
    "styles/**/*.css"
  ],
  "exclude": ["node_modules", "dist"]
}
