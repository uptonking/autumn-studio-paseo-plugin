{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "lib": [
      "ES2021",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "client/**/*",
    "server/**/*",
    "shared/**/*",
    "test/**/*",
    "index.client.tsx",
    "index.server.ts",
    "styles/**/*.css"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
